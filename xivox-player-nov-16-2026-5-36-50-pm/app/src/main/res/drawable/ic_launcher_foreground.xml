        android:strokeWidth="2.4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82"
                android:endY="82"
                android:startX="26"
                android:startY="26"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- XIVOX intersecting X + Play prism -->
    <path
        android:pathData="M42,37L68,54L42,71Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="68"
                android:endY="71"
